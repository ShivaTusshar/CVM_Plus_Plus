// Recursive factorial — demonstrates function declarations and recursion.

fn factorial(n) {
    if (n < 2) {
        return 1;
    }
    return n * factorial(n - 1);
}

print factorial(0);   // 1
print factorial(1);   // 1
print factorial(5);   // 120
print factorial(10);  // 3628800
print factorial(15);  // 1307674368000

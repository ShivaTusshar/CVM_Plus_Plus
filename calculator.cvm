// CVM++ Calculator
// First input: Operation (1 for Add, 2 for Sub, 3 for Mul, 4 for Div)
// Second input: Operand A
// Third input: Operand B

let op = input;
let a = input;
let b = input;

if (op == 1) {
    print a + b;
} else {
    if (op == 2) {
        print a - b;
    } else {
        if (op == 3) {
            print a * b;
        } else {
            if (op == 4) {
                print a / b;
            }
        }
    }
}
// FizzBuzz in CVM++ (prints numeric tags since we have only Int/Bool).
//   0  -> multiple of 15 (FizzBuzz)
//   3  -> multiple of 3  (Fizz)
//   5  -> multiple of 5  (Buzz)
//   n  -> the number itself otherwise

let n = 20;
let i = 1;
while (i < n + 1) {
    if ((i / 15) * 15 == i) {
        print 0;
    } else {
        if ((i / 3) * 3 == i) {
            print 3;
        } else {
            if ((i / 5) * 5 == i) {
                print 5;
            } else {
                print i;
            }
        }
    }
    i = i + 1;
}
